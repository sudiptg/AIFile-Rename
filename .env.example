# ===================== REQUIRED =====================
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# ===================== PEOPLE =====================
# Extra users allowed from the very first start (comma separated user ids).
AUTH_USERS=
# Extra ADMINS from the very first start (the owner can also add admins with /addadmin).
ADMIN_USERS=

# ===================== LOOK =====================
BOT_NAME=FlyTon V.I.P
# WELCOME_PIC=https://example.com/picture.jpg
# DEFAULT_RENAME_FORMAT=[FlyTon] {title} S{season}E{episode} {quality}
NOTIFY_OWNER_ON_START=true

# ===================== LIMITS =====================
# Parallel files at once (can also be changed live from /admin). VPS: 2-4 is comfortable.
MAX_CONCURRENT_TASKS=1
MAX_PARALLEL=8
MAX_TRANSMISSIONS=15
ARIA2_CONNECTIONS=16
# Telegram bots can upload up to 2 GB per file.
MAX_FILE_SIZE=2000000000
# Size (px) of the HD cover shown on top of videos (thumbnail itself is always 320 px: Telegram limit).
COVER_SIZE=1280

# ===================== STORAGE =====================
# VPS: leave empty (data is kept in DATA_DIR/database.json).
# Render FREE: MongoDB is REQUIRED because the disk is wiped on every restart.
MONGO_URI=
MONGO_DB_NAME=autorename_bot
DATA_DIR=data
DOWNLOAD_DIR=downloads

# ===================== WEB / KEEP-ALIVE =====================
PORT=8080
# Render FREE only: ping the public URL so the service does not sleep.
KEEP_ALIVE=false
# APP_URL=https://your-app.onrender.com
PING_INTERVAL=240
